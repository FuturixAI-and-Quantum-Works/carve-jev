CARVE_MODEL=Qwen/Qwen3.8-27B-FP8
CARVE_TOKENIZER=Qwen/Qwen3.8-27B-FP8
CARVE_SERVED_MODEL=qwen38-27b
CARVE_SYSTEM_NAME=CARVE-27B
CARVE_GPU=0
CARVE_VLLM_HOST=127.0.0.1
CARVE_VLLM_PORT=8000
CARVE_API_HOST=127.0.0.1
CARVE_API_PORT=8011
CARVE_MAX_MODEL_LEN=8192
CARVE_MAX_NUM_SEQS=32
CARVE_MAX_BATCHED_TOKENS=8192
CARVE_GPU_MEMORY_UTILIZATION=0.85
CARVE_MAX_CONCURRENCY=32
CARVE_MAX_BATCH_SIZE=256
VLLM_BIN=vllm
PYTHON_BIN=python
# Native sampling avoids a FlashInfer SM120 startup failure observed with
# vLLM 0.30.0 on RTX PRO 6000 Blackwell.
VLLM_USE_FLASHINFER_SAMPLER=0

# Optional full Decision 1.0 benchmark overrides. Without these, the benchmark
# wrapper fetches the pinned public Kev checkout into .cache/kev.
# CARVE_TEST_SUITE=/path/to/transfer-v9/test.jsonl
# CARVE_DEV_SUITE=/path/to/transfer-v9/development.jsonl
# CARVE_BENCHMARK_OUTPUT=artifacts/reproduced-summary.json
# CARVE_BENCHMARK_CHECKOUT=.cache/kev
